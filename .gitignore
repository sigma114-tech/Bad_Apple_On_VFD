# --- CMake / Ninja ---
build/
build-*/
CMakeFiles/
CMakeCache.txt
cmake-build-*/
Testing/
*.ninja
.ninja_log
.ninja_deps
install_manifest.txt

# --- 工具生成产物（GCC/LD 等） ---
*.o
*.obj
*.d
*.a
*.lib
*.lst
*.map
*.out

# --- 固件镜像 ---
*.elf
*.hex
*.bin
*.dfu

# 如果你想把 PC 端生成的帧 .bin 不入库（推荐用 Git LFS；见下）
Image_Encode/*.bin

# --- VS Code ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# --- IDE/系统杂项 ---
.ide/
.idea/
.DS_Store
Thumbs.db

# --- Python（你的编码 & 发送脚本） ---
__pycache__/
*.pyc
.venv/
venv/
ENV/
.env
.env.*
pip-wheel-metadata/

# --- STM32CubeMX 辅助 ---
# .ioc 配置文件要提交（保留），不要忽略
